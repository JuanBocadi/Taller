    <script>
        const toggleBtn = document.getElementById('themeToggle');
        const html = document.documentElement;
        
        // Mantener memoria del último tema usado
        const currentTheme = localStorage.getItem('theme') || 'light';
        if(currentTheme === 'dark') setTheme('dark');

        toggleBtn.addEventListener('click', () => {
            const isDark = html.getAttribute('data-theme') === 'dark';
            setTheme(isDark ? 'light' : 'dark');
        });

        function setTheme(theme) {
            html.setAttribute('data-theme', theme);
            html.setAttribute('data-bs-theme', theme); 
            localStorage.setItem('theme', theme);
            toggleBtn.innerHTML = theme === 'dark' ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
        }
    </script>
    
    <script>
        const buscador = document.getElementById('buscadorPatente');
        const tbody = document.getElementById('tablaVehiculosBody');
        const searchWrapper = document.getElementById('searchWrapper');
        let timeoutId;

        buscador.addEventListener('input', function () {
            const query = this.value;
            searchWrapper.classList.add('is-loading');
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => {
                fetch(`/Home/BuscarAjax?query=${encodeURIComponent(query)}`)
                    .then(r => r.json())
                    .then(data => {
                        tbody.innerHTML = '';
                        searchWrapper.classList.remove('is-loading');
                        data.forEach((item, index) => {
                            const tr = document.createElement('tr');
                            tr.className = "fade-in-row";
                            tr.style.animationDelay = `${index * 50}ms`;
                            tr.style.borderBottom = "1px solid var(--border-color)";
                            
                            let nombreAuto = (item.marca && item.marca !== "A DEFINIR") ? `${item.marca} ${item.modelo}` : item.modelo;

                            tr.innerHTML = `
                                <td class="px-4 py-3">
                                    <span class="badge bg-dark text-white fs-6 px-3 py-2 rounded-pill shadow-sm" style="letter-spacing: 1.5px; font-family: monospace;">${item.patenteFormateada}</span>
                                </td>
                                <td class="px-4 py-3 fw-medium">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: var(--sidebar-hover);"><i class="fas fa-car" style="color: var(--text-secondary);"></i></div>
                                        <span style="color: var(--text-primary);">${nombreAuto}</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <span class="badge rounded-pill ${item.reparacionesCount > 0 ? 'text-bg-info text-white' : 'border text-secondary'} px-3 py-2">
                                        <i class="fas fa-wrench me-1"></i> ${item.reparacionesCount} trabajos
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <a href="/Vehiculos/Details/${item.patente}" class="btn btn-sm rounded-pill px-3 hover-shadow" style="background-color: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-primary);">Abrir <i class="fas fa-chevron-right ms-1 small"></i></a>
                                </td>`;
                            tbody.appendChild(tr);
                        });
                    });
            }, 300);
        });
    </script>

